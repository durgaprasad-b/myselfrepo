        <!-- ========================= -->
        <!-- ROLE 1                    -->
        <!-- ========================= -->

        <role>

            <id>role1</id>

            <permissions>


                <!-- ========================================= -->
                <!-- CLIENT-SPECIFIC DATA                       -->
                <!-- ========================================= -->

                <permission>

                    <topic>data/${{clientid}}/#</topic>

                </permission>


                <!-- ========================================= -->
                <!-- RETAINED PUBLISH                          -->
                <!-- ========================================= -->

                <permission>

                    <topic>outgoing/${{clientid}}</topic>

                    <activity>PUBLISH</activity>

                    <retain>RETAINED</retain>

                </permission>


                <!-- ========================================= -->
                <!-- USERNAME-SPECIFIC SUBSCRIPTION             -->
                <!-- ========================================= -->

                <permission>

                    <topic>incoming/${{username}}/actions</topic>

                    <activity>SUBSCRIBE</activity>

                </permission>


                <!-- ========================================= -->
                <!-- SPARKPLUG PUBLISH                          -->
                <!-- ========================================= -->

                <permission>

                    <topic>spBv1.0/Meta/#</topic>

                    <activity>PUBLISH</activity>

                </permission>


                <!-- ========================================= -->
                <!-- SPARKPLUG SUBSCRIBE                        -->
                <!-- ========================================= -->

                <permission>

                    <topic>spBv1.0/#</topic>

                    <activity>SUBSCRIBE</activity>

                </permission>


                <!-- ========================================= -->
                <!-- SPARKPLUG NCMD                              -->
                <!-- ========================================= -->

                <permission>

                    <topic>spBv1.0/Meta/NCMD/Backend</topic>

                    <activity>SUBSCRIBE</activity>

                </permission>


                <!-- ========================================= -->
                <!-- SPARKPLUG DCMD                              -->
                <!-- ========================================= -->

                <permission>

                    <topic>spBv1.0/Meta/DCMD/Backend/#</topic>

                    <activity>SUBSCRIBE</activity>

                </permission>


            </permissions>

        </role>


        <!-- ========================= -->
        <!-- SUPERUSER                  -->
        <!-- ========================= -->

        <role>

            <id>superuser</id>

            <permissions>

                <permission>

                    <topic>#</topic>

                    <activity>ALL</activity>

                </permission>

            </permissions>

        </role>

    </roles>

